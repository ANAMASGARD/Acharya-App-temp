# =============================================================================
# Acharya — environment variables
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in Clerk + Neo4j Aura values
# 3. Restart Expo after changes:  npx expo start --clear
#
# Never commit .env — it is gitignored.
# =============================================================================

# --- Client (Expo) — safe to expose with EXPO_PUBLIC_ prefix ---

# Required — Clerk publishable key (Dashboard → API keys → Quick Copy)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here

# Optional — Clerk Account Portal URL for profile settings in browser (Expo Go fallback)
# EXPO_PUBLIC_CLERK_ACCOUNT_PORTAL_URL=

# --- Server (API routes) — NEVER expose to mobile client ---

# Required — Clerk secret key (Dashboard → API keys) — server/API routes only
CLERK_SECRET_KEY=sk_test_your_secret_key_here

# Required — Neo4j AuraDB (primary database — HACKHAZARDS track)
# Create instance: https://console.neo4j.io
# URI must use neo4j+s:// (Aura TLS). bolt://localhost is NOT valid for Acharya core data.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_aura_password_here
NEO4J_DATABASE=neo4j

# Optional — quote values if they contain spaces
# AURA_INSTANCENAME="Free instance"

# Optional — Aura API provisioning (CI/admin only)
# AURA_CLIENT_ID=
# AURA_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Setup checklist
# -----------------------------------------------------------------------------
#
# Clerk (auth)
#   - Native API enabled: https://dashboard.clerk.com/~/native-applications
#   - Email verification code (passwordless OTP) enabled
#   - Google + Facebook SSO enabled; redirect URL acharyaapp://
#
# Neo4j Aura (database — mandatory)
#   - Create AuraDB Free/Pro instance at https://console.neo4j.io
#   - Copy connection URI (neo4j+s://…) and password into .env above
#   - Apply schema: cypher-shell -a "$NEO4J_URI" -u neo4j -p "$NEO4J_PASSWORD" -f neo4j/schema.cypher
#   - Verify: GET /api/health/neo4j (live Cypher on Aura)
#
# Do NOT put CLERK_SECRET_KEY or NEO4J credentials in EXPO_PUBLIC_ vars.
# -----------------------------------------------------------------------------

# --- AI (server / API routes only) ---

# Sarvam AI — speech-to-text, recorder LLM, TTS. Get key: https://docs.sarvam.ai
# SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v3
# Sarvam LLM — recorder teaching analysis + class notes (after STT)
# SARVAM_LLM_MODEL=sarvam-30b
# SARVAM_TTS_MODEL=bulbul:v3

# Chat Acharya voice agent — single .env for Expo app + Python services
# See docs/VOICE.md. Local Expo Go: run ./localvoiceagent.sh (auto-sets LAN IP).
# VOICE_GATEWAY_WSS_URL=ws://192.168.1.42:8080/voice
# VOICE_SESSION_SIGNING_SECRET=generate-a-long-random-secret
# VOICE_AGENT_WEBHOOK_SECRET=generate-another-long-random-secret
# ACHARYA_API_BASE_URL=https://your-eas-api-url
# EAS APK (LiveKit Cloud free Build tier):
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
# LIVEKIT_AGENT_NAME=acharya-voice-agent

# OpenRouter — shared API key; model vars are feature-specific
# OPENROUTER_API_KEY=
# RAG, community seed, vision fallback (recorder uses SARVAM_LLM_MODEL instead)
# OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
# Chat Acharya inbox only (fast multilingual coach)
# OPENROUTER_CHATBOX_MODEL=google/gemini-2.5-flash-lite
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-001
# NOTES_MAX_UPLOAD_BYTES=10485760
# RAG_DEBUG=true

# Chat agent web search — set ANY ONE (priority: Tavily > Brave > Serper).
# Lets the coach fetch current/official info (latest CBSE/ICSE syllabus, circulars).
# When none is set, web search is disabled; the agent still uses curriculum + memory.
# TAVILY_API_KEY=
# BRAVE_SEARCH_API_KEY=
# SERPER_API_KEY=

# Demo only — auto-seed LLM-written teacher community posts when feed has no real posts
# Remove or set false in production
# COMMUNITY_DEMO_SEED=true

# NCERT demo books → Aura embeddings (one book per class — see books/demo-books.json)
# INGEST_EMBED_BATCH_SIZE=96
# INGEST_WRITE_BATCH_SIZE=100
# INGEST_PARSE_CONCURRENCY=8
# INGEST_SKIP_EXISTING=true
#
# One command after .env is filled:
#   npm run books:embed

# Optional — native Sign in with Google (dev build only, not Expo Go)
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Optional — Clerk test email OTP (development only)
# Use address format: yourname+clerk_test@example.com
# Verification code: 424242
